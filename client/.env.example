# AccessMap Frontend Environment Configuration Example
# 
# For local development with Vite dev proxy (recommended):
# Leave VITE_API_BASE_URL commented out or set to '/api'.
# Vite will proxy requests starting with '/api' to http://localhost:5000 (no CORS required).
#
# VITE_API_BASE_URL=/api

# For direct production or remote API endpoints (requires backend CORS):
# VITE_API_BASE_URL=http://localhost:5000/api
